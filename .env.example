# Copy to server/.env (local) or add as Replit Secrets.

# Recommended: a long random string used to sign login tokens.
# If unset, one is generated and saved next to the database on first start.
JWT_SECRET=

# Your Anthropic API key. Without it the server runs in demo mode (simulated agent replies).
ANTHROPIC_API_KEY=

# Optional
PORT=3000
DATABASE_PATH=data/agentry.db
ALLOW_SIGNUP=false          # true = anyone can create an account (multi-user / SaaS mode)
MAX_CONCURRENT_RUNS=4
MAX_TURNS_PER_RUN=25
TZ=UTC                      # time zone used for agent schedules
ALLOW_PRIVATE_HTTP=false    # true = let the http_request tool reach localhost / private IPs
AGENTRY_MOCK=false          # true = force demo mode even with an API key
